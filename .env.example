# Frontend build-time value. Set this to the Vercel API origin only, without
# /api/applications. It is required for submissions and never defaults to Vite.
VITE_API_BASE_URL=https://your-vercel-project.vercel.app

# Backend-only values. Add these in Vercel Project Settings > Environment Variables.
ALLOWED_ORIGINS=https://your-chapter-domain.example
GOOGLE_SERVICE_ACCOUNT_EMAIL=chapter-applications-writer@example-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=replace-with-spreadsheet-id
GOOGLE_SHEET_RANGE=Applications!A:I
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Optional GitHub Pages project-site path. Use '/' for a custom domain.
GITHUB_PAGES_BASE_PATH=/acm-student-chapter/
