# Copy this file to .env.local for local development. Do not commit .env.local.
#
# Mode A: Vite on 5173, Vercel functions on 3000.
VITE_API_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mode B: run the project through `vercel dev` on 3000 instead. Replace the
# two values above with the following exact values:
# VITE_API_BASE_URL=http://localhost:3000
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use a non-production Supabase project for local verification.
SUPABASE_URL=https://your-test-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-test-project-secret-key
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
