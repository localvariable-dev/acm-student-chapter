# Copy this file to .env.local for local development. Do not commit .env.local.
#
# Mode A: Vite on 5173, Vercel functions on 3000.
VITE_API_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mode B: run the project through `vercel dev` on 3000 instead. Replace the
# two values above with the following exact values:
# VITE_API_BASE_URL=http://localhost:3000
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use a test spreadsheet and test-only service account for local verification.
GOOGLE_SERVICE_ACCOUNT_EMAIL=chapter-applications-writer@example-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=replace-with-test-spreadsheet-id
GOOGLE_SHEET_RANGE=Applications!A:I
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
